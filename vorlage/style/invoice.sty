% ============================================================
% invoice.sty — mechanics. No choices here (style/defaults.sty) and no
% identity (include/issuer.tex). No tax logic anywhere: the document
% prints what it is given; which VAT case applies, which rate, which
% note, is decided outside (rechnung.yaml -> resolve()).
%
% Document data (preamble, after the packages):
%   \InvoiceKind{invoice|creditnote|cancellation|quote}   default: invoice
%   \InvoiceNumber{2026-0001}   \InvoiceDate{22 September 2026}   \InvoiceCurrency{EUR}
% Blocks (body, in this order):
%   \invoiceaddress{recipient lines}{\metarow{label}{value}... \metasep \metarow...}   block 2 + 3
%   \invoiceheading                                 block 4: "<kind> <number>" + grey hairline
%   <introduction paragraph>                        block 5: content
%   \begin{positions}[vat] \pos{..}{..}{..}{..}{..}{..} / \posvat{..}{7 args} \end{positions}   block 6
%   \begin{totals} \totalrow{label}{\money{EUR}{..}} ... \totalfinal{label}{..} \end{totals}   block 7
%   <tax note paragraph>                            block 8: content, from resolve()
%   \invoicepayment{due date}{reference}            block 8: standard sentence with slots
%   \invoiceclosing[text]                           closing + "valid without signature" (toggles)
%   \invoiceattachments{\attachmentrow{1}{text}...} list at the end of the body
%   \attachmentspage{\attachmentfile{1}{text}{file.pdf}...}   page 2: heading + list
%   \attachmentpdf{1}{attachments/file.pdf}         appends the receipt pages (pdfpages)
%   \begin{timesheet}[unit label]{position no} \timesheetrow{date}{activity}{3.5} ... \timesheettotal{12.0} \end{timesheet}
%   \posunit{day}                                   unit dictionary (day, days, hour, hours, flat, each, km)
%   \InvStr...                                      every fixed string, overridable per document
%   \money{EUR}{1200.50}  \pct{19}                  money & numbers (include/currency.tex)
%   \stub{note}                                     placeholder marker
% Footer (every page) and letterhead (page 1) come from include/issuer.tex.
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style/invoice}[2026/09/22 invoice mechanics]

\RequirePackage{style/defaults}
\RequirePackage{etoolbox}
\RequirePackage{iftex}

