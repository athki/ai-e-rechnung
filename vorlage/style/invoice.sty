% ------------------------------------------------------------
% Lists: flat, tight, accent markers + compact list for table cells
% ------------------------------------------------------------
\RequirePackage{enumitem}
\setlist{leftmargin=\InvoiceListIndent, itemsep=\InvoiceItemSep, parsep=0pt, topsep=3pt}
\setlist[itemize,1]{label=\textcolor{Accent}{\rule[0.35ex]{0.55em}{0.55em}}}
\setlist[itemize,2]{label=\textcolor{Accent!70}{\rule[0.35ex]{0.4em}{0.4em}}}
\setlist[enumerate,1]{label=\InvRunFont\color{Accent}\arabic*.}
\newlist{celllist}{itemize}{1}
\setlist[celllist]{label=\textcolor{Accent}{\rule[0.3ex]{0.4em}{0.4em}},
  leftmargin=1.2em, itemsep=0pt, parsep=0pt, topsep=2pt, partopsep=0pt,
  after=\vspace{-\baselineskip}}

% ------------------------------------------------------------
% Letterhead (page 1): absolute placement under the accent frame rule
% ------------------------------------------------------------
\RequirePackage{tikz}
\newcommand{\inv@letterhead}{%
  \begin{tikzpicture}[remember picture, overlay]
    \draw[Accent, line width=\InvoiceRuleHeavy]
      ([xshift=\InvoiceMarginLeft, yshift=-\InvoiceFrameTop]current page.north west) --
      ([xshift=-\InvoiceMarginRight, yshift=-\InvoiceFrameTop]current page.north east);
    \node[anchor=north west, inner sep=0pt, text width=\textwidth, align=left,
          font=\InvHeadFont\InvoiceLetterheadSize, text=InkMain]
      at ([xshift=\InvoiceMarginLeft, yshift=-\InvoiceLetterheadTop]current page.north west)
      {\InvIssuerName};
    % Links die Postanschrift, rechts die Kontaktwege: so bleibt der Kopf ruhig und
    % die Kontaktdaten stehen nicht im Anschriftfeld, das der Umschlag zeigt.
    \node[anchor=north west, inner sep=0pt, text width=0.55\textwidth, align=left,
          font=\InvRunFont\InvoiceLabelSize, text=InkSoft]
      at ([xshift=\InvoiceMarginLeft, yshift=-\InvoiceLetterheadLinesTop]current page.north west)
      {\InvIssuerAddressLine\ifdefempty{\InvIssuerCountry}{}{\ \textperiodcentered\ \InvIssuerCountry}};
    \node[anchor=north east, inner sep=0pt, text width=0.40\textwidth, align=right,
          font=\InvRunFont\InvoiceLabelSize, text=InkSoft]
      at ([xshift=-\InvoiceMarginRight, yshift=-\InvoiceLetterheadLinesTop]current page.north east)
      {\InvIssuerEmail\\\InvIssuerPhone\\\InvIssuerWeb};
  \end{tikzpicture}}

% ------------------------------------------------------------
% Footer (every page): accent frame rule, then bank · tax IDs · page
% ------------------------------------------------------------
\RequirePackage{lastpage}
\RequirePackage{refcount}   % \getpagerefnumber: Seitenzahl als Zahl, fuer \ifnum
\newcommand{\inv@footer}{%
  \parbox[b]{\textwidth}{%
    {\color{Accent}\hrule height \InvoiceRuleHeavy}\par
    \vspace{7pt}%
    {\InvRunFont\InvoiceFooterSize\color{InkSoft}%
      \begin{minipage}[t]{60mm}\raggedright
        \InvIssuerPerson\\IBAN \InvIssuerIban\\BIC \InvIssuerBic\ \textperiodcentered\ \InvIssuerBank
      \end{minipage}\hfill
      \begin{minipage}[t]{50mm}\raggedright
        \InvStrTaxNo\ \InvIssuerTaxNo\\\InvStrVatId\ \InvIssuerVatId
      \end{minipage}\hfill
      \begin{minipage}[t]{30mm}\raggedleft
        \mbox{}\\\mbox{}\\%
        % Einseitige Rechnungen brauchen kein "Seite 1 von 1".
        \ifnum\getpagerefnumber{LastPage}>1
          \InvStrPage~\thepage\ \InvStrOf~\getpagerefnumber{LastPage}%
        \fi
      \end{minipage}\par}}}

% ------------------------------------------------------------
% Page styles: page 1 = letterhead, page 2+ = running header with grey hairline
% ------------------------------------------------------------
\RequirePackage{fancyhdr}
\fancypagestyle{invoicefirst}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
  \fancyhead[C]{\inv@letterhead}%
  \fancyfoot[C]{\inv@footer}}
\fancypagestyle{invoice}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{\InvoiceRuleHair}%
  \renewcommand{\headrule}{{\color{RuleGrey}\hrule width\headwidth height\headrulewidth}}%
  \renewcommand{\footrulewidth}{0pt}%
  \fancyhead[L]{\InvRunFont\InvoiceRunningSize\color{InkSoft}\InvStrKindLabel\ \InvNumber\ \textperiodcentered\ \InvIssuerName}%
  \fancyhead[R]{\InvRunFont\InvoiceRunningSize\color{InkSoft}\InvDate}%
  \fancyfoot[C]{\inv@footer}}
\pagestyle{invoice}
% Page 1 starts automatically: letterhead style, flow pushed down so that the
% top of the recipient's first line sits at \InvoiceRecipientTop from the edge
% (\vspace* leaves an empty box at the page top, hence topskip + baselineskip + parskip).
\AtBeginDocument{\thispagestyle{invoicefirst}%
  \vspace*{\dimexpr\InvoiceRecipientTop-\InvoiceMarginTop-\topskip-\baselineskip-\parskip+\ht\strutbox\relax}}

% ------------------------------------------------------------
% Block 2 + 3: recipient (left) and metadata (right)
% ------------------------------------------------------------
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\newcolumntype{D}{>{\raggedright\arraybackslash}X}   % umbrechende Textspalte (Metadaten, Positionen)
\newcommand{\metarow}[2]{#1 & #2\\}
% Grauer Strich zwischen den Abschnitten (Rechnung · unsere Steuerdaten · Kundendaten); so breit wie die Spalte.
\newcommand{\metasep}{\specialrule{\InvoiceRuleHair}{\InvoiceMetaSepSkip}{\InvoiceMetaSepSkip}}
% Die Ruecksendeangabe steht klein ueber der Empfaengeranschrift, damit die Post den
% Brief zurueckschicken kann. Nur Name, Strasse, Ort - keine Kontaktdaten.
\newcommand{\inv@senderline}{%
  \ifdefempty{\InvIssuerSenderLine}{}{%
    {\InvRunFont\InvoiceSenderLineSize\color{InkSoft}\InvIssuerSenderLine\par}%
    \vspace{\InvoiceSenderLineSkip}}}
\newcommand{\invoiceaddress}[2]{%
  \noindent
  \begin{minipage}[t]{\InvoiceRecipientWidth}\raggedright\setlength{\parskip}{0pt}%
    \inv@senderline #1\par\end{minipage}%
  \hfill
  \begin{minipage}[t]{\InvoiceMetaWidth}\raggedright\setlength{\parskip}{0pt}%
    % Unsichtbares Gegenstück zur Rücksendeangabe: sonst begänne der Metadatenblock
    % eine Zeile höher als die Empfängeranschrift.
    \ifdefempty{\InvIssuerSenderLine}{}{%
      {\InvoiceSenderLineSize\strut\par}\vspace{\InvoiceSenderLineSkip}}%
    \renewcommand{\arraystretch}{1.18}%
    \arrayrulecolor{RuleGrey}%
    % Die Wertspalte nimmt die Restbreite und bricht um: eine lange Referenz läuft
    % sonst rechts aus der Seite.
    \begin{tabularx}{\linewidth}[t]{@{}>{\InvRunFont\InvoiceLabelSize\color{InkSoft}}l@{\hspace{1.4em}}D@{}}
      #2
    \end{tabularx}\par\arrayrulecolor{black}%
  \end{minipage}\par}

% ------------------------------------------------------------
% Block 4: heading — "<kind> <number>" by default, any text via the optional argument
% ------------------------------------------------------------
\newcommand{\invoiceheading}[1][\InvStrKindLabel\ \InvNumber]{%
  \par\vspace{9mm}%
  {\InvHeadFont\InvoiceHeadingSize\color{InkMain}#1\par}%
  \nopagebreak\vspace{1.6mm}\nopagebreak
  {\color{RuleGrey}\hrule height \InvoiceRuleLight}\par
  \vspace{3.5mm}}

% ------------------------------------------------------------
% Block 6: positions table (grey rules, sans grey header, decimal-aligned amounts)
%   \begin{positions}       Pos · Description · Qty · Unit · Unit price · Amount
%   \begin{positions}[vat]  … · VAT · Amount   (only when an invoice mixes rates)
% ------------------------------------------------------------
\newcolumntype{Q}{S[table-format=\InvoiceQtyFormat, table-text-alignment=right]}
\newcolumntype{M}{S[table-format=\InvoiceAmountFormat, table-text-alignment=right]}
\newcolumntype{P}{@{}l D Q l M M@{}}      % single-rate invoice
\newcolumntype{V}{@{}l D Q l M r M@{}}    % mixed-rate invoice (VAT column)
\newcommand{\tabhead}[1]{\multicolumn{1}{l}{\InvRunFont\InvoiceTableHeadSize\color{InkSoft}#1}}
\newcommand{\tabheadr}[1]{\multicolumn{1}{r}{\InvRunFont\InvoiceTableHeadSize\color{InkSoft}#1}}
\newcommand{\tabheadrr}[2]{\multicolumn{1}{r}{\InvRunFont\InvoiceTableHeadSize\color{InkSoft}%
  \begin{tabular}[b]{@{}r@{}}#1\\#2\end{tabular}}}
\newif\ifinv@vat
\newcommand{\inv@header}{%
  \tabhead{\InvStrPos} & \tabhead{\InvStrDescription} & \tabheadr{\InvStrQty} & \tabhead{\InvStrUnit} &
  \tabheadrr{\InvStrUnitPrice}{(\InvCurrency)} & \tabheadrr{\InvStrAmount}{(\InvCurrency)}\\}
\newcommand{\inv@headervat}{%
  \tabhead{\InvStrPos} & \tabhead{\InvStrDescription} & \tabheadr{\InvStrQty} & \tabhead{\InvStrUnit} &
  \tabheadrr{\InvStrUnitPrice}{(\InvCurrency)} & \tabheadr{\InvStrVat} & \tabheadrr{\InvStrAmount}{(\InvCurrency)}\\}
\newenvironment{positions}[1][]{%
  \par\vspace{2mm}%
  \InvoiceTableSize\setlength{\tabcolsep}{\InvoiceTabColSep}%
  \renewcommand{\arraystretch}{\InvoiceTableStretch}%
  \arrayrulecolor{RuleGrey}%
  \ifstrequal{#1}{vat}{\inv@vattrue\def\inv@spec{V}}{\inv@vatfalse\def\inv@spec{P}}%
  \edef\inv@begin{\noexpand\tabularx{\noexpand\textwidth}{\inv@spec}}%
  \noindent\inv@begin
  \toprule
  \ifinv@vat\inv@headervat\else\inv@header\fi
  \midrule}{%
  \bottomrule
  \endtabularx\par\arrayrulecolor{black}}
\newcommand{\posunit}[1]{\ifcsdef{InvStr@unit@#1}{\csuse{InvStr@unit@#1}}{#1}}
\newcommand{\pos}[6]{#1 & #2 & #3 & \posunit{#4} & #5 & #6\\}
\newcommand{\posvat}[7]{#1 & #2 & #3 & \posunit{#4} & #5 & #6 & #7\\}

% ------------------------------------------------------------
% Block 7: totals, right-aligned under the table; as many lines as given
% ------------------------------------------------------------
\newenvironment{totals}{%
  \par\vspace{3mm}%
  \renewcommand{\arraystretch}{1.2}%
  \arrayrulecolor{RuleGrey}%
  \hfill\begin{tabular}{@{}l@{\hspace{3em}}r@{}}}{%
  \end{tabular}\par\arrayrulecolor{black}\vspace{2mm}}
\newcommand{\totalrow}[2]{#1 & #2\\}
\newcommand{\totalfinal}[2]{\midrule\textbf{#1} & {\bfseries #2}\\}

% ------------------------------------------------------------
% Block 8: payment sentence, closing, signature line, attachments list
% ------------------------------------------------------------
\newcommand{\invoicepayment}[2]{\par\InvStrPayment{#1}{#2}\par}
\newcommand{\invoiceclosing}[1][\InvStrClosing]{%
  \ifInvoiceClosing\par\vspace{2mm}#1\\\InvIssuerPerson\par\fi
  \ifInvoiceNoSignatureLine{\InvoiceSmallSize\color{InkSoft}\InvStrNoSignature\par}\fi}
\newcommand{\attachmentrow}[2]{& #1 & #2\\}
\newcommand{\invoiceattachments}[1]{%
  \par\vspace{3mm}%
  \begin{tabular}{@{}>{\InvRunFont\InvoiceLabelSize\color{InkSoft}}l@{\hspace{1.4em}}r@{\hspace{0.8em}}l@{}}
    \InvStrAttachments #1
  \end{tabular}\par}

% ------------------------------------------------------------
% Attachments page and appended receipt PDFs
% ------------------------------------------------------------
\RequirePackage{pdfpages}
\newcommand{\attachmentfile}[3]{#1 & #2 & #3\\}
\newcommand{\attachmentspage}[1]{%
  \clearpage
  \invoiceheading[\InvStrAttachments]%
  \begin{tabular}{@{}r@{\hspace{0.8em}}l@{\hspace{2em}}>{\InvRunFont\InvoiceLabelSize\color{InkSoft}}l@{}}
    #1
  \end{tabular}\par}
\newcommand{\inv@stamp}[1]{%
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=north east, inner sep=0pt, font=\InvRunFont\InvoiceLabelSize, text=InkSoft]
      at ([xshift=-\InvoiceMarginRight, yshift=-22mm]current page.north east)
      {\InvStrAttachmentStamp{#1}};
  \end{tikzpicture}}
% \attachmentpdf{n}{file}: every page of the PDF, scaled to sit inside header and footer
\newcommand{\attachmentpdf}[2]{%
  \includepdf[pages=-, scale=0.78, offset=0 -3mm,
    pagecommand={\thispagestyle{invoice}\ifInvoiceAttachmentStamp\inv@stamp{#1}\fi}]{#2}}

% ------------------------------------------------------------
% Timesheet page: \begin{timesheet}[unit label]{position no} ... \end{timesheet}
% ------------------------------------------------------------
\newcolumntype{T}{@{}l D Q@{}}
\newcommand{\inv@tsheader}[1]{\tabhead{\InvStrDateCol} & \tabhead{\InvStrActivity} & \tabheadr{#1}\\}
\newenvironment{timesheet}[2][\InvStrHours]{%
  \clearpage
  \invoiceheading[\InvStrTimesheet\ --- \InvStrPosition~#2]%
  \InvoiceTableSize\setlength{\tabcolsep}{\InvoiceTabColSep}%
  \renewcommand{\arraystretch}{\InvoiceTableStretch}%
