{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Write(//**/rechnung.resolved.json)",
      "Edit(//**/rechnung.resolved.json)",
      "Write(//**/*.pdf)",
      "Edit(//**/*.pdf)",
      "Write(//**/status.yaml)",
      "Edit(//**/status.yaml)",
      "Write(//**/pro-forma/**)",
      "Edit(//**/pro-forma/**)",
      "Write(//**/stammdaten/ich.yaml)",
      "Edit(//**/stammdaten/ich.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/schutz.sh"
          }
        ]
      }
    ]
  }
}
